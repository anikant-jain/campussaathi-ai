{
  "name": "campussaathi-ai",
  "version": "1.0.0",
  "description": "CampusSaathi AI — Intelligent Campus Operating System",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "build": "tsc && vite build && esbuild server/index.ts --bundle --platform=node --target=node24 --packages=external --outfile=build-server/index.cjs",
    "preview": "vite preview",
    "start": "node build-server/index.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx server/seed.ts",
    "db:admin": "tsx server/seed.ts --admin",
    "test": "tsx --test tests/unit.test.mts tests/api.test.ts",
    "test:postgres": "node tests/postgres.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.108.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.469.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-pgvector": "^0.1.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@playwright/test": "^1.65.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}

HOST=0.0.0.0
PORT=5000
NODE_ENV=development
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0
SESSION_SECRET=
DEMO_MODE=true

# Use DATABASE_URL for PostgreSQL + pgvector. When empty, use the SQLite file.
DATABASE_URL=
CAMPUS_DB=./server/data/campus.sqlite
CAMPUS_TIMEZONE=Asia/Kolkata
# Optional one-time import source for the old complaint demo data.
DATA_PATH=./server/data/db.json

# Pick demo, gemini, or openai. Set the actual model ID available for your key.
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
EMBEDDING_MODEL=

# Optional SMTP for password reset. Configure PUBLIC_ORIGIN before enabling.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENABLE_REMINDERS=true

# Bootstrap one administrator using npm run db:admin, then remove the password.
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NAME=
# Docker Compose only. Use URL-safe characters.
POSTGRES_PASSWORD=

